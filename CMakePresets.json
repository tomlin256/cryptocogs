{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {"name": "base", "hidden": true, "binaryDir": "${sourceDir}/build/${presetName}"},
    {"name": "macos-arm64", "hidden": true, "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"}},
    {"name": "linux-arm64", "hidden": true, "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}},
    {"name": "linux-x86_64", "hidden": true, "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}},
    {"name": "release", "hidden": true, "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "debug", "hidden": true, "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "release-macos-arm64", "inherits": ["base", "release", "macos-arm64"]},
    {"name": "release-linux-arm64", "inherits": ["base", "release", "linux-arm64"]},
    {"name": "release-linux-x86_64", "inherits": ["base", "release", "linux-x86_64"]},
    {"name": "debug-macos-arm64", "inherits": ["base", "debug", "macos-arm64"]},
    {"name": "debug-linux-arm64", "inherits": ["base", "debug", "linux-arm64"]},
    {"name": "debug-linux-x86_64", "inherits": ["base", "debug", "linux-x86_64"]}
  ],
  "buildPresets": [
    {"name": "release-macos-arm64", "configurePreset": "release-macos-arm64", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"}},
    {"name": "release-linux-arm64", "configurePreset": "release-linux-arm64", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}},
    {"name": "release-linux-x86_64", "configurePreset": "release-linux-x86_64", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}},
    {"name": "debug-macos-arm64", "configurePreset": "debug-macos-arm64", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"}},
    {"name": "debug-linux-arm64", "configurePreset": "debug-linux-arm64", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}},
    {"name": "debug-linux-x86_64", "configurePreset": "debug-linux-x86_64", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}}
  ],
  "testPresets": [
    {"name": "release-macos-arm64", "configurePreset": "release-macos-arm64", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"}, "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "release-linux-arm64", "configurePreset": "release-linux-arm64", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}, "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "release-linux-x86_64", "configurePreset": "release-linux-x86_64", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}, "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "debug-macos-arm64", "configurePreset": "debug-macos-arm64", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"}, "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "debug-linux-arm64", "configurePreset": "debug-linux-arm64", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}, "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "debug-linux-x86_64", "configurePreset": "debug-linux-x86_64", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}, "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}}
  ]
}
