CompileFlags:
  # The editing host's tree (plan 028): clangd runs on the Mac, so this is the Mac's debug tree. Another host
  # edits this line. A tree has a compile_commands.json once it has been configured.
  CompilationDatabase: build/debug-macos-arm64

Diagnostics:
  ClangTidy:
    Add:
      - bugprone-*
      - performance-*
      - cppcoreguidelines-pro-type-member-init
    Remove:
      - bugprone-easily-swappable-parameters
      - bugprone-narrowing-conversions

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  BlockEnd: Yes
