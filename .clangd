CompileFlags:
  # The editing host's tree (plan 028): clangd runs on the Mac, so this is the Mac's debug tree. Another host
  # edits this line. A tree has a compile_commands.json once it has been configured.
  CompilationDatabase: build/debug-macos-arm64

# The clang-tidy checks are in .clang-tidy (plan 035), which clangd reads too: one list serves the editor and the gate.

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  BlockEnd: Yes
